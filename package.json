{
  "name": "poker-hands-workspace",
  "private": true,
  "workspaces": [
    "packages/library",
    "packages/wasm",
    "packages/service",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build:library && npm run build:wasm && npm run build:service && npm run build:cli",
    "build:library": "cd packages/library && npm run build",
    "build:wasm": "cd packages/wasm && npm run build",
    "build:service": "cd packages/service && npm run build",
    "build:cli": "cd packages/cli && npm run build",
    "test": "npm run test:library && npm run test:wasm && npm run test:service && npm run test:cli",
    "test:library": "cd packages/library && npm test",
    "test:wasm": "cd packages/wasm && npm run test",
    "test:service": "cd packages/service && npm test",
    "test:cli": "cd packages/cli && npm test",
    "lint": "npm run lint:library && npm run lint:wasm && npm run lint:service && npm run lint:cli",
    "lint:library": "cd packages/library && npm run lint",
    "lint:wasm": "cd packages/wasm && npm run lint",
    "lint:service": "cd packages/service && npm run lint",
    "lint:cli": "cd packages/cli && npm run lint",
    "clean": "npm run clean:library && npm run clean:wasm && npm run clean:service && npm run clean:cli",
    "clean:library": "cd packages/library && npm run clean",
    "clean:wasm": "cd packages/wasm && npm run clean",
    "clean:service": "cd packages/service && npm run clean",
    "clean:cli": "cd packages/cli && npm run clean",
    "prepack": "npm run build",
    "test:watch": "npm run test:library -- --watch",
    "test:full": "npm run test:library -- --testPathPattern=__tests__/full",
    "cli": "cd packages/cli && npm run start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "@types/node": "^24.19.0",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
