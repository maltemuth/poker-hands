{
  "name": "@malte.muth/poker-hands-cli",
  "version": "0.4.1",
  "private": false,
  "description": "A command-line interface for the poker hands library, providing tools for calculating odds and hand percentages",
  "main": "dist/index.js",
  "bin": {
    "poker-hands": "dist/cli.js"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "odds",
    "cli",
    "cards"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/malte-muth/poker-hands.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/cli.ts",
    "test": "jest"
  },
  "dependencies": {
    "@malte.muth/poker-hands": "file:../library",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=10.8.2"
  }
}
