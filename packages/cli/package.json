{
  "name": "@malte.muth/poker-hands-cli",
  "version": "0.10.0",
  "private": false,
  "description": "A command-line interface for the poker hands library, providing tools for calculating odds and hand percentages",
  "main": "dist/index.js",
  "bin": {
    "poker-hands": "dist/cli.js"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "odds",
    "cli",
    "cards"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/malte-muth/poker-hands.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "start": "tsx src/cli.ts",
    "test": "npm run typecheck && jest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@malte.muth/poker-hands": "^0.10.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=10.8.2"
  }
}
