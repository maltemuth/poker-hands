{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poker Hands CLI Odds Command Output",
  "description": "JSON schema for the output of the 'poker-hands odds' command",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the calculation was successful"
    },
    "command": {
      "type": "string",
      "enum": ["odds"],
      "description": "The command that was executed"
    },
    "data": {
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "description": "Array of players with their hole cards and odds",
          "items": {
            "type": "object",
            "properties": {
              "holeCards": {
                "type": "array",
                "description": "The player's hole cards",
                "items": {
                  "type": "string",
                  "description": "A card in the format 'valueSuit' (e.g., 'Ah', 'Td', '2c')"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "winChance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Probability of winning (0-1)"
              },
              "tieChance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Probability of tying (0-1)"
              }
            },
            "required": ["holeCards", "winChance", "tieChance"]
          }
        }
      },
      "required": ["players"]
    },
    "error": {
      "type": "string",
      "description": "Error message if the calculation failed"
    }
  },
  "required": ["success", "command"],
  "oneOf": [
    {
      "properties": {
        "success": { "const": true },
        "data": { "$ref": "#/properties/data" }
      },
      "required": ["success", "command", "data"]
    },
    {
      "properties": {
        "success": { "const": false },
        "error": { "$ref": "#/properties/error" }
      },
      "required": ["success", "command", "error"]
    }
  ],
  "examples": [
    {
      "success": true,
      "command": "odds",
      "data": {
        "players": [
          {
            "holeCards": ["Ah", "Kh"],
            "winChance": 0.65,
            "tieChance": 0.05
          },
          {
            "holeCards": ["Qd", "Jd"],
            "winChance": 0.3,
            "tieChance": 0.05
          }
        ]
      }
    },
    {
      "success": false,
      "command": "odds",
      "error": "Invalid card format: 'invalid'"
    }
  ]
}
