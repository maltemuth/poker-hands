              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "royalFlush": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        }
      },
      "required": [
        "highCard",
        "pair",
        "twoPair",
        "threeOfAKind",
        "straight",
        "flush",
        "fullHouse",
        "fourOfAKind",
        "straightFlush",
        "royalFlush"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "string",
      "description": "Error message if the calculation failed"
    }
  },
  "required": ["success", "command"],
  "oneOf": [
    {
      "properties": {
        "success": { "const": true },
        "data": { "$ref": "#/properties/data" }
      },
      "required": ["success", "command", "data"]
    },
    {
      "properties": {
        "success": { "const": false },
        "error": { "$ref": "#/properties/error" }
      },
      "required": ["success", "command", "error"]
    }
  ],
  "examples": [
    {
      "success": true,
      "command": "percentages",
      "data": {
        "highCard": {
          "count": 123456,
          "percentage": 0.123456
        },
        "pair": {
          "count": 98765,
          "percentage": 0.098765
        },
        "twoPair": {
          "count": 45678,
          "percentage": 0.045678
        },
        "threeOfAKind": {
          "count": 23456,
          "percentage": 0.023456
        },
        "straight": {
          "count": 12345,
          "percentage": 0.012345
        },
        "flush": {
          "count": 9876,
          "percentage": 0.009876
        },
        "fullHouse": {
          "count": 2345,
          "percentage": 0.002345
        },
        "fourOfAKind": {
          "count": 123,
          "percentage": 0.000123
        },
        "straightFlush": {
          "count": 12,
          "percentage": 0.000012
        },
        "royalFlush": {
          "count": 1,
          "percentage": 0.000001
        }
      }
    },
    {
      "success": false,
      "command": "percentages",
      "error": "Invalid card format: 'invalid'"
    }
  ]
