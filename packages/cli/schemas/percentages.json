{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poker Hands CLI Percentages Command Output",
  "description": "JSON schema for the output of the 'poker-hands percentages' command",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the calculation was successful"
    },
    "command": {
      "type": "string",
      "enum": ["percentages"],
      "description": "The command that was executed"
    },
    "data": {
      "type": "object",
      "description": "Hand type probability distribution",
      "properties": {
        "highCard": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "pair": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "twoPair": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "threeOfAKind": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "straight": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "flush": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "fullHouse": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Probability of this hand type (0-1)"
            }
          },
          "required": ["count", "percentage"]
        },
        "fourOfAKind": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of times this hand type was observed"
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
