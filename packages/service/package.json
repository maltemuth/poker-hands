{
  "name": "@malte.muth/poker-hands-service",
  "version": "0.11.0",
  "private": false,
  "description": "A HTTP API service for Texas Hold'em poker odds calculation. Built on Express.js with TypeScript.",
  "main": "dist/index.js",
  "bin": {
    "poker-hands-service": "dist/cli.js"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "odds",
    "api",
    "express",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maltemuth/poker-hands.git",
    "directory": "packages/service"
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "lint": "eslint src __tests__ index.ts --ext .ts",
    "clean": "rm -rf dist",
    "test": "npm run typecheck && npm run lint:spec && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "openapi-typescript openapi.yaml -o src/types/api.ts --check && tsc -p tsconfig.test.json",
    "generate": "openapi-typescript openapi.yaml -o src/types/api.ts",
    "lint:spec": "redocly lint openapi.yaml",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@malte.muth/poker-hands": "^0.11.0",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.55.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=10.8.2"
  },
  "author": "Malte Muth",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
