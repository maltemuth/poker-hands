{
  "name": "@malte.muth/poker-hands-service",
  "version": "0.4.1",
  "private": false,
  "description": "A HTTP API service for Texas Hold'em poker odds calculation. Built on Express.js with TypeScript.",
  "main": "dist/index.js",
  "bin": {
    "poker-hands-service": "dist/cli.js"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "odds",
    "api",
    "express",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/malte-muth/poker-hands.git",
    "directory": "packages/service"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "npm run typecheck && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@malte.muth/poker-hands": "file:../library",
    "ajv": "^8.20.0",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=10.8.2"
  }
}
