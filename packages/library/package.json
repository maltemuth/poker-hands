{
  "name": "@malte.muth/poker-hands",
  "version": "0.11.0",
  "private": false,
  "description": "A comprehensive TypeScript library for Texas Hold'em poker hand evaluation and odds calculation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "poker",
    "texas-holdem",
    "hand-evaluation",
    "odds",
    "typescript",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maltemuth/poker-hands.git",
    "directory": "packages/library"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "npm run typecheck && jest",
    "test:watch": "jest --watch",
    "lint": "eslint src __tests__ __perf__ index.ts --ext .ts",
    "lint:fix": "eslint src __tests__ __perf__ index.ts --ext .ts --fix",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "bench": "tsx __perf__/benchmark.ts"
  },
  "author": "Malte Muth",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=10.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
